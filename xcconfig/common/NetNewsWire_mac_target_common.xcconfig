#include "./NetNewsWire_version.xcconfig"

// High Level Settings common to both the Mac application and any extensions we bundle with it
// Local/dev build default only. Release IPAs get this overridden to the
// release tag by .github/workflows/release.yml (build-ipa-release job).
MARKETING_VERSION = 7.1.1

APP_GROUP_ID = group.$(ORGANIZATION_IDENTIFIER).NetNewsWire-Evergreen$(APP_GROUP_SUFFIX)

ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor;
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
COMBINE_HIDPI_IMAGES = YES
SDKROOT = macosx;
