+      -destination 'platform=iOS Simulator,name=iPhone 17' \
+      -resultBundlePath build/ui-test.xcresult \
+      test > build/ui-test.log 2>&1
+    status=$?
+    tail -n 40 build/ui-test.log
+    echo
+    echo "--- [NectarUITest] lines ---"
+    grep '\[NectarUITest\]' build/ui-test.log
+    exit "$status"
