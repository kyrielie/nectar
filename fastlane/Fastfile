# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  desc "Generate new localized screenshots"
  lane :screenshots do
    variants = {
      "01-light-default" => ["-UITestSeedDemoData", "-userInterfaceColorPalette", "1", "-accentColor", "0", "-currentThemeName", "Default"],
      "02-dark-default" => ["-UITestSeedDemoData", "-userInterfaceColorPalette", "2", "-accentColor", "0", "-currentThemeName", "Default"],
      "03-light-sepia" => ["-UITestSeedDemoData", "-userInterfaceColorPalette", "1", "-accentColor", "6", "-currentThemeName", "Sepia"],
      "04-dark-biblioteca" => ["-UITestSeedDemoData", "-userInterfaceColorPalette", "2", "-accentColor", "8", "-currentThemeName", "Biblioteca"],
      "05-dark-duskbloom" => ["-UITestSeedDemoData", "-userInterfaceColorPalette", "2", "-surfaceTint", "4", "-accentColor", "5", "-currentThemeName", "Duskbloom", "-UITestReadingProfile", "personal"],
      "06-light-duskbloom" => ["-UITestSeedDemoData", "-userInterfaceColorPalette", "1", "-surfaceTint", "4", "-accentColor", "5", "-currentThemeName", "Duskbloom", "-UITestReadingProfile", "personal"]
    }

    variants.each do |name, launch_arguments|
      capture_screenshots(
        scheme: "Nectar-iOSUITests",
        launch_arguments: launch_arguments,
        output_directory: "./screenshots/#{name}"
      )
    end

    # Adds a framed copy of every screenshot alongside the raw ones (see
    # docs/ui-test-demo-data.md) rather than replacing them. Requires
    # imagemagick on the machine running fastlane.
    frame_screenshots(path: "./screenshots")
  end
end
