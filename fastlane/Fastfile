# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  desc "Generate new localized screenshots"
  lane :screenshots do
    capture_screenshots(
      scheme: "Nectar-iOSUITests",
      launch_arguments: [
        # 1: light, default accent, default reading theme
        "-UITestSeedDemoData -userInterfaceColorPalette 1 -accentColor 0 -currentThemeName Default",
        # 2: dark, default accent, default reading theme
        "-UITestSeedDemoData -userInterfaceColorPalette 2 -accentColor 0 -currentThemeName Default",
        # 3: light, ocean accent, Sepia reading theme
        "-UITestSeedDemoData -userInterfaceColorPalette 1 -accentColor 6 -currentThemeName Sepia",
        # 4: dark, lavender accent, Biblioteca reading theme
        "-UITestSeedDemoData -userInterfaceColorPalette 2 -accentColor 8 -currentThemeName Biblioteca",
        # 5: dark, berry surface + accent, Duskbloom reading theme, personal font/line-height profile
        "-UITestSeedDemoData -userInterfaceColorPalette 2 -surfaceTint 4 -accentColor 5 -currentThemeName Duskbloom -UITestReadingProfile personal",
        # 6: light, berry surface + accent, Duskbloom reading theme, personal font/line-height profile
        "-UITestSeedDemoData -userInterfaceColorPalette 1 -surfaceTint 4 -accentColor 5 -currentThemeName Duskbloom -UITestReadingProfile personal",
      ]
    )

    # Adds a framed copy of every screenshot alongside the raw ones (see
    # docs/ui-test-demo-data.md) rather than replacing them. Requires
    # imagemagick on the machine running fastlane.
    frame_screenshots(path: "./screenshots")
  end
end
